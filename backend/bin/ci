#!/usr/bin/env ruby
require_relative "../config/boot"
require "active_support/continuous_integration"

CI = ActiveSupport::ContinuousIntegration
CI.run do
  step "Setup", "bin/rails db:test:prepare"
  step "Style", "bundle exec rubocop"
  step "Security", "bundle exec brakeman --quiet --no-pager --exit-on-warn --exit-on-error"
  step "Tests", "bin/rails test"
end
