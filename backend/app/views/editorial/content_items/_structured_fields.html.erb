<%# Structured fields for the content types the mobile games read.
    Locals: type (String), values (Hash of current values). %>
<% v = values || {} %>
<% case type %>
<% when "word" %>
  <div class="form-grid">
    <div><%= label_tag "fields_word", "Mizo word" %><%= text_field_tag "fields[word]", v["word"], id: "fields_word", required: true, placeholder: "Sakei" %></div>
    <div><%= label_tag "fields_english_gloss", "English meaning" %><%= text_field_tag "fields[english_gloss]", v["english_gloss"], id: "fields_english_gloss", required: true, placeholder: "Tiger" %></div>
  </div>
  <%= label_tag "fields_meaning_mizo", "Mizo meaning (clue)" %>
  <%= text_area_tag "fields[meaning_mizo]", v["meaning_mizo"], id: "fields_meaning_mizo", class: "prose", required: true, rows: 2, placeholder: "Sakei chu ramsa hlauhawm tak a ni." %>
  <p class="hint">Shown as the clue in Spelling, Crossword and Tawng Upa.</p>
  <%= label_tag "fields_example_mizo", "Example sentence" %>
  <%= text_area_tag "fields[example_mizo]", v["example_mizo"], id: "fields_example_mizo", class: "prose", required: true, rows: 2 %>
  <p class="hint">Also becomes a Sentence Builder exercise when the word is tagged for it.</p>
  <div class="form-grid">
    <div><%= label_tag "fields_category", "Category" %><%= select_tag "fields[category]", options_for_select(Editorial::BodyForm::CATEGORIES.map { |key, name| ["#{name} (#{key})", key] }, v["category"]), id: "fields_category", include_blank: "Choose…", required: true %></div>
    <div><%= label_tag "fields_difficulty", "Level (1 = easiest, 7 = hardest)" %><%= select_tag "fields[difficulty]", options_for_select((1..7).to_a, v["difficulty"] || 1), id: "fields_difficulty" %></div>
  </div>
  <fieldset class="picture-field">
    <legend>Picture (Picture Match, Thumal Kawp)</legend>
    <div class="picture-row">
      <div class="picture-preview">
        <% if v["image"].is_a?(Hash) && v["image"]["checksum"].present? %>
          <%= image_tag editorial_word_image_path(v["image"]["checksum"]), alt: "Current picture" %>
        <% elsif v["emoji"].present? %>
          <span class="emoji-preview"><%= v["emoji"] %></span>
        <% else %>
          <span class="muted">No picture</span>
        <% end %>
      </div>
      <div class="picture-inputs">
        <%= label_tag "fields_emoji", "Emoji" %><%= text_field_tag "fields[emoji]", v["emoji"], id: "fields_emoji", placeholder: "Optional, e.g. a single emoji", maxlength: 16 %>
        <%= label_tag "fields_image", "Upload picture (PNG, JPEG or WebP, up to 512 KB)" %><%= file_field_tag "fields[image]", id: "fields_image", accept: "image/png,image/jpeg,image/webp" %>
        <% if v["image"].present? %><div class="check-row"><%= check_box_tag "fields[remove_image]", "1", false, id: "fields_remove_image" %><%= label_tag "fields_remove_image", "Remove uploaded picture" %></div><% end %>
      </div>
    </div>
    <p class="hint">An uploaded picture wins over the emoji. Leave both empty for abstract words — they are then kept out of picture games.</p>
  </fieldset>
  <label>Games that use this word</label>
  <div class="check-grid">
    <% Editorial::BodyForm::GAME_MODES.each do |mode, name| %>
      <div class="check-row"><%= check_box_tag "fields[game_modes][]", mode, Array(v["game_modes"]).include?(mode), id: "fields_mode_#{mode}" %><%= label_tag "fields_mode_#{mode}", name %></div>
    <% end %>
  </div>
  <p class="hint">Leave every box empty to allow all games.</p>
<% when "question" %>
  <%= label_tag "fields_prompt_mizo", "Question (Mizo)" %>
  <%= text_area_tag "fields[prompt_mizo]", v["prompt_mizo"], id: "fields_prompt_mizo", class: "prose", required: true, rows: 2, placeholder: "“Tlawmngaihna” tih hian eng nge a kawh?" %>
  <label>Four options</label>
  <div class="form-grid">
    <% 4.times do |index| %>
      <div><%= text_field_tag "fields[options][]", Array(v["options"])[index], id: "fields_option_#{index}", required: true, placeholder: "Option #{(65 + index).chr}", "aria-label": "Option #{(65 + index).chr}" %></div>
    <% end %>
  </div>
  <%= label_tag "fields_answer", "Correct answer (type it exactly as one of the options)" %>
  <%= text_field_tag "fields[answer]", v["answer"], id: "fields_answer", required: true %>
  <%= label_tag "fields_explanation_mizo", "Explanation shown after answering" %>
  <%= text_area_tag "fields[explanation_mizo]", v["explanation_mizo"], id: "fields_explanation_mizo", class: "prose", required: true, rows: 2 %>
  <div class="form-grid">
    <div><%= label_tag "fields_emoji", "Emoji" %><%= text_field_tag "fields[emoji]", v["emoji"], id: "fields_emoji", placeholder: "Optional (defaults to 💬)", maxlength: 16 %></div>
    <div><%= label_tag "fields_difficulty", "Level (1–7)" %><%= select_tag "fields[difficulty]", options_for_select((1..7).to_a, v["difficulty"] || 1), id: "fields_difficulty" %></div>
  </div>
<% when "game_copy" %>
  <%= label_tag "fields_game_id", "Game" %>
  <%= select_tag "fields[game_id]", options_for_select(Editorial::BodyForm::GAMES.map { |key, name| [name, key] }, v["game_id"]), id: "fields_game_id", include_blank: "Choose…", required: true %>
  <p class="hint">Leave any field empty to keep the app's built-in text. <code>{word}</code> is replaced with the word being asked about.</p>
  <div class="form-grid">
    <div><%= label_tag "fields_title", "Title" %><%= text_field_tag "fields[title]", v["title"], id: "fields_title" %></div>
    <div><%= label_tag "fields_subtitle", "Subtitle" %><%= text_field_tag "fields[subtitle]", v["subtitle"], id: "fields_subtitle" %></div>
  </div>
  <%= label_tag "fields_instructions", "How to play (one step per line)" %>
  <%= text_area_tag "fields[instructions]", v["instructions"], id: "fields_instructions", class: "prose", rows: 3 %>
  <%= label_tag "fields_prompt", "Question text" %>
  <%= text_field_tag "fields[prompt]", v["prompt"], id: "fields_prompt", placeholder: "He thlalak hming hi eng nge?" %>
  <%= label_tag "fields_hint", "Hint text" %>
  <%= text_field_tag "fields[hint]", v["hint"], id: "fields_hint" %>
  <div class="form-grid">
    <div><%= label_tag "fields_correct_feedback", "Correct answer title" %><%= text_field_tag "fields[correct_feedback]", v["correct_feedback"], id: "fields_correct_feedback", placeholder: "A dik e!" %></div>
    <div><%= label_tag "fields_retry_feedback", "Wrong answer title" %><%= text_field_tag "fields[retry_feedback]", v["retry_feedback"], id: "fields_retry_feedback", placeholder: "Tum leh rawh" %></div>
  </div>
<% when "sentence" %>
  <%= label_tag "fields_text_mizo", "Mizo sentence" %>
  <%= text_area_tag "fields[text_mizo]", v["text_mizo"], id: "fields_text_mizo", class: "prose", required: true, rows: 2, placeholder: "Kan inah lo kal rawh." %>
  <p class="hint">Sentence Builder splits it at spaces into tiles.</p>
  <%= label_tag "fields_english_support", "English meaning" %>
  <%= text_field_tag "fields[english_support]", v["english_support"], id: "fields_english_support", required: true %>
  <%= label_tag "fields_difficulty", "Level (1–7)" %><%= select_tag "fields[difficulty]", options_for_select((1..7).to_a, v["difficulty"] || 1), id: "fields_difficulty" %>
<% end %>
