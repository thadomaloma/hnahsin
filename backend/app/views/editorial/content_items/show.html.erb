<div class="section-head"><div><span class="eyebrow" style="color:var(--green-dark)"><%= @content_item.content_type.humanize %> · <%= @content_item.locale %></span><h1><%= @content_item.title %></h1><p class="code muted"><%= @content_item.stable_id %></p></div><div class="actions"><% if current_user.can_edit? %><%= link_to edit_editorial_content_item_path(@content_item), class: "button ghost" do %><%= action_icon(:edit) %>Edit details<% end %><% end %></div></div>
<div class="card"><p>Status <span class="pill <%= @content_item.status %>"><%= @content_item.status.humanize %></span></p><p class="muted">Required review: <%= @content_item.required_review_kinds.map(&:humanize).to_sentence %></p></div>
<div class="split"><section><div class="section-head"><h2><%= section_icon(:history) %>Revision history</h2></div><table><thead><tr><th>Revision</th><th>Status</th><th>Author</th><th>Checksum</th></tr></thead><tbody><% @revisions.each do |revision| %><tr><td><%= link_to "r#{revision.number}", editorial_content_item_content_revision_path(@content_item, revision) %></td><td><span class="pill <%= revision.status %>"><%= revision.status.humanize %></span></td><td><%= revision.author.email %></td><td class="code"><%= revision.checksum.first(12) %>…</td></tr><% end %></tbody></table></section><% if current_user.can_edit? && @content_item.current_revision %><aside><div class="section-head"><h2><%= metric_icon(:draft) %>Create revision</h2></div><div class="form-card"><% if Editorial::BodyForm.structured?(@content_item.content_type) %><%= form_with url: editorial_content_item_content_revisions_path(@content_item), multipart: true do |form| %><%= render "editorial/content_items/structured_fields", type: @content_item.content_type, values: Editorial::BodyForm.values(content_type: @content_item.content_type, body: @content_item.current_revision.body) %><div style="margin-top:18px"><%= form.submit "Save new draft" %></div><% end %><details class="advanced-json"><summary>Advanced: edit revision JSON</summary><%= form_with scope: :content_revision, url: editorial_content_item_content_revisions_path(@content_item) do |form| %><%= form.label :body_json, "Revision JSON" %><%= form.text_area :body_json, value: JSON.pretty_generate(@content_item.current_revision.body), spellcheck: false %><%= form.submit "Save JSON draft" %><% end %></details><% else %><%= form_with scope: :content_revision, url: editorial_content_item_content_revisions_path(@content_item) do |form| %><%= form.label :body_json, "Revision JSON" %><%= form.text_area :body_json, value: JSON.pretty_generate(@content_item.current_revision.body), spellcheck: false %><%= form.submit "Save new draft" %><% end %><% end %></div></aside><% end %></div>
