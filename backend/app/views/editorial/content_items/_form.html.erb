<% structured = local_assigns[:structured] %>
<%= form_with model: [:editorial, content_item], multipart: true do |form| %>
  <% if content_item.new_record? %><%= form.label :stable_id, "Stable ID" %><%= form.text_field :stable_id, required: true, placeholder: structured ? { "word" => "word.sakei", "question" => "question.tawng-upa.001", "game_copy" => "game.picture_match", "sentence" => "sentence.101" }[content_item.content_type] : "word.inn" %><p class="hint">Lowercase letters, numbers, dots, hyphens and underscores only. Never reuse an ID.</p><% else %><label>Stable ID</label><p class="code"><%= content_item.stable_id %></p><% end %>
  <%= form.label :title %><%= form.text_field :title, required: !structured, placeholder: structured ? "Optional — defaults to the word or question" : "Inn" %>
  <% if content_item.new_record? && structured %>
    <%= form.hidden_field :content_type %><%= form.hidden_field :locale %>
    <%= render "editorial/content_items/structured_fields", type: content_item.content_type, values: local_assigns[:values] %>
  <% elsif content_item.new_record? %>
    <%= form.label :content_type %><%= form.select :content_type, ContentItem.content_types.keys.map { |type| [type.humanize, type] } %><%= form.label :locale %><%= form.select :locale, [["Mizo (lus)", "lus"]] %>
    <%= label_tag "content_item_body_json", "Initial revision JSON" %><%= text_area_tag "content_item[body_json]", "{\n  \"word\": \"In\",\n  \"meaning_mizo\": \"Mihring chenna hmun\",\n  \"english_gloss\": \"House\",\n  \"example_mizo\": \"Kan inah lo kal rawh.\",\n  \"emoji\": \"🏠\",\n  \"category\": \"chhungkua\",\n  \"difficulty\": 1\n}", id: "content_item_body_json", spellcheck: false %><p class="hint">Stories, culture cards and seasonal trails use reviewed structured JSON.</p>
  <% else %>
    <label>Content contract</label><p><%= content_item.content_type.humanize %> · Mizo (lus)</p>
  <% end %>
  <div style="margin-top:22px"><%= form.submit content_item.new_record? ? "Create draft" : "Save details" %></div>
<% end %>
