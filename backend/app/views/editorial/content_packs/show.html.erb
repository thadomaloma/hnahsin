<div class="section-head"><div><span class="eyebrow" style="color:var(--green-dark)">Published release</span><h1>Pack <%= @content_pack.pack_version %></h1><p class="code muted"><%= @content_pack.public_id %></p></div></div><div class="split"><section class="card"><p><span class="pill <%= @content_pack.status %>"><%= @content_pack.status.humanize %></span></p><p><strong><%= @content_pack.content_pack_entries.count %></strong> reviewed content items</p><p class="code muted"><%= @content_pack.checksum %></p><p><%= link_to "View raw manifest JSON", api_v1_content_pack_path(@content_pack.public_id), target: "_blank", rel: "noopener", class: "button ghost compact" %></p><h2><%= section_icon(:inbox) %>Items in this release</h2><table><thead><tr><th>Content</th><th>Type</th><th>Revision</th><th>Checksum</th></tr></thead><tbody><% @revisions.each do |revision| %><% item = revision.content_item %><tr><td><%= link_to item.title, editorial_content_item_path(item) %><br><span class="code muted"><%= item.stable_id %></span></td><td><%= item.content_type.humanize %></td><td>r<%= revision.number %></td><td class="code"><%= revision.checksum.first(12) %>…</td></tr><% end %></tbody></table><%= render "shared/pager", pagy: @pagy %></section><aside class="card"><h2><%= section_icon(:rollback) %>Safe rollback</h2><p class="muted">Rollback republishes this exact reviewed selection as a new immutable version. Existing clients can keep their last valid pack.</p><% if current_user.can_publish? %><%= form_with scope: :content_pack, url: rollback_editorial_content_pack_path(@content_pack), method: :post do |form| %><%= form.label :pack_version, "New version" %><%= form.text_field :pack_version, required: true, placeholder: "1.0.1" %><div style="margin-top:14px"><%= form.submit "Publish rollback", data: { turbo_confirm: "Publish a rollback to this release?" } %></div><% end %><% end %></aside></div>
