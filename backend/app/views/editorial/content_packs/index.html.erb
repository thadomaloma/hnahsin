<div class="section-head"><div><span class="eyebrow" style="color:var(--green)">Immutable delivery</span><h1>Content releases</h1></div><% if current_user.can_publish? %><%= link_to new_editorial_content_pack_path, class: "button" do %><%= action_icon(:upload) %>Publish pack<% end %><% end %></div><table><thead><tr><th>Version</th><th>Status</th><th>Items</th><th>Published</th><th>Checksum</th></tr></thead><tbody><% @content_packs.each do |pack| %><tr><td><%= link_to pack.pack_version, editorial_content_pack_path(pack) %><% if pack.rollback_of %><br><small class="muted">Rollback of <%= pack.rollback_of.pack_version %></small><% end %></td><td><span class="pill <%= pack.status %>"><%= pack.status.humanize %></span></td><td><%= pack.content_pack_entries.count %></td><td><%= pack.published_at ? time_ago_in_words(pack.published_at) + " ago" : "—" %></td><td class="code"><%= pack.checksum.first(12) %>…</td></tr><% end %></tbody></table>
<%= render "shared/pager", pagy: @pagy %>
