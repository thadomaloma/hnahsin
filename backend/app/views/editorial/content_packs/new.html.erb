<div class="section-head"><div><span class="eyebrow" style="color:var(--green-dark)">Release channel</span><h1>Publish content pack</h1></div></div><div class="form-card"><%= form_with scope: :content_pack, url: editorial_content_packs_path do |form| %><%= form.label :pack_version, "Semantic version" %><%= form.text_field :pack_version, required: true, placeholder: "1.0.0" %><label>Approved content</label><% if @approved_items.any? %><% @approved_items.each do |item| %><div class="check-row"><%= check_box_tag "content_pack[content_item_ids][]", item.id, true, id: "content_item_#{item.id}" %><%= label_tag "content_item_#{item.id}", "#{item.title} · #{item.stable_id}" %></div><% end %><%= form.submit "Publish immutable pack", data: { turbo_confirm: "Publish this reviewed pack?" } %><% else %><div class="empty">No fully approved content is ready.</div><% end %><% end %></div>
