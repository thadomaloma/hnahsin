<div class="section-head"><div><span class="eyebrow" style="color:var(--green)">Reviewer queue</span><h1>Review flagged words</h1><p class="muted">These words were flagged when imported. Look each one up in your own dictionary, note the short English meaning you find, then choose <strong>OK</strong>, <strong>Fix</strong> or <strong>Drop</strong>. Don't copy long definitions or example sentences from a dictionary.</p></div></div>

<nav class="type-tabs" aria-label="Flag reason">
  <% Editorial::FlagReview::GROUPS.each do |group, name| %>
    <%= link_to "#{name} (#{@group_counts[group]})", editorial_flag_reviews_path(group: group), class: ("current" if group == @group), "aria-current": ("page" if group == @group) %>
  <% end %>
</nav>

<div id="queue">
<% if @rows.empty? %>
  <div class="card empty">Nothing left to review here. 🎉</div>
<% end %>
<% @rows.each do |row| %>
  <% v = row.values %>
  <% approved_kinds = row.revision.review_decisions.select(&:decision_approved?).map(&:review_kind) %>
  <% own = row.revision.author_id == current_user.id %>
  <section class="card flag-card" id="item-<%= row.item.id %>">
    <div class="flag-head">
      <div>
        <h2><%= link_to v["word"].presence || row.item.title, editorial_content_item_path(row.item) %></h2>
        <p class="code muted"><%= row.item.stable_id %> · r<%= row.revision.number %></p>
      </div>
      <div class="flag-pills">
        <% row.item.required_review_kinds.each do |kind| %>
          <span class="pill <%= approved_kinds.include?(kind) ? "approved" : "in_review" %>"><%= kind.humanize %> <%= approved_kinds.include?(kind) ? "✓" : "pending" %></span>
        <% end %>
      </div>
    </div>
    <dl class="preview-list">
      <dt>English</dt><dd><strong><%= v["english_gloss"] %></strong></dd>
      <dt>Mizo meaning</dt><dd><%= v["meaning_mizo"] %></dd>
      <% if v["example_mizo"].present? %><dt>Example</dt><dd>“<%= v["example_mizo"] %>”</dd><% end %>
      <dt>Why flagged</dt><dd class="muted"><%= row.notes %></dd>
    </dl>
    <% if own %>
      <p class="hint">You wrote this revision, so another reviewer must decide on it.</p>
    <% else %>
      <%= form_with url: editorial_flag_review_path(row.item, group: @group, page: @pagy.page), method: :patch, class: "flag-form" do %>
        <div class="form-grid">
          <div>
            <%= label_tag "gloss-#{row.item.id}", "Dictionary meaning (a few words)" %>
            <%= text_field_tag :dictionary_gloss, nil, id: "gloss-#{row.item.id}", class: "dictionary-gloss", placeholder: "e.g. hornbill", data: { ours: v["english_gloss"] }, autocomplete: "off" %>
            <p class="hint match-hint" aria-live="polite"></p>
          </div>
          <div>
            <label>Decision</label>
            <div class="decision-row">
              <% [["ok", "OK"], ["fix", "Fix"], ["drop", "Drop"]].each do |value, label| %>
                <label class="decision decision-<%= value %>"><%= radio_button_tag :decision, value, false, id: "decision-#{row.item.id}-#{value}", required: true %> <%= label %></label>
              <% end %>
            </div>
          </div>
        </div>
        <div class="fix-fields">
          <div class="form-grid">
            <div><%= label_tag "fixen-#{row.item.id}", "Corrected English meaning" %><%= text_field_tag :fixed_english, nil, id: "fixen-#{row.item.id}" %></div>
            <div><%= label_tag "fixmz-#{row.item.id}", "Corrected Mizo meaning" %><%= text_field_tag :fixed_mizo, nil, id: "fixmz-#{row.item.id}" %></div>
          </div>
          <p class="hint">Only needed for <strong>Fix</strong>. Write the meaning in your own words.</p>
        </div>
        <%= label_tag "note-#{row.item.id}", "Note (optional)" %>
        <%= text_field_tag :note, nil, id: "note-#{row.item.id}" %>
        <div style="margin-top:14px"><%= submit_tag "Save decision", class: "button" %></div>
      <% end %>
    <% end %>
  </section>
<% end %>
</div>
<%= render "shared/pager", pagy: @pagy %>
<script src="/flag_review.js" defer></script>
