<div class="section-head"><div><span class="eyebrow" style="color:var(--green)"><%= @content_item.title %></span><h1>Revision <%= @revision.number %></h1></div><div class="actions"><% if current_user.can_edit? && @revision.status_draft? %><%= button_to "Submit for review", submit_editorial_content_item_content_revision_path(@content_item, @revision), method: :post %><% end %><% if @revision.status_in_review? && @content_item.required_review_kinds.any? { |kind| current_user.can_review?(kind) } %><%= link_to "Record review", new_editorial_content_item_content_revision_review_decision_path(@content_item, @revision), class: "button" %><% end %></div></div>
<div class="split"><section class="card"><p><span class="pill <%= @revision.status %>"><%= @revision.status.humanize %></span></p><%= render "editorial/content_revisions/preview", content_item: @content_item, revision: @revision %><details class="advanced-json"><summary>Revision JSON</summary><pre class="json"><%= JSON.pretty_generate(@revision.body) %></pre></details><p class="code muted"><%= @revision.checksum %></p></section><aside class="card"><h2><%= metric_icon(:approved) %>Approval record</h2><% if @revision.review_decisions.any? %><ul class="list"><% @revision.review_decisions.each do |review| %><li><span><strong><%= review.review_kind.humanize %></strong><small class="muted"> · <%= review.reviewer.email %><br><%= review.notes.presence || "No notes" %></small></span><span class="pill <%= review.decision %>"><%= review.decision.humanize %></span></li><% end %></ul><% else %><div class="empty">No review decision yet.</div><% end %></aside></div>
