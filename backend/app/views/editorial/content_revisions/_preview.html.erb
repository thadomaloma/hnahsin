<%# Readable preview of a structured revision, so reviewers check what learners will see. %>
<% type = content_item.content_type %>
<% if Editorial::BodyForm.structured?(type) %>
  <% v = Editorial::BodyForm.values(content_type: type, body: revision.body) %>
  <div class="learner-preview">
    <h3>What learners see</h3>
    <% case type %>
    <% when "word" %>
      <div class="picture-row">
        <div class="picture-preview">
          <% if v["image"].is_a?(Hash) && v["image"]["checksum"].present? %>
            <%= image_tag editorial_word_image_path(v["image"]["checksum"]), alt: "Picture for #{v["word"]}" %>
          <% elsif v["emoji"].present? %><span class="emoji-preview"><%= v["emoji"] %></span>
          <% else %><span class="muted">No picture</span><% end %>
        </div>
        <dl class="preview-list">
          <dt>Word</dt><dd><strong><%= v["word"] %></strong> — <%= v["english_gloss"] %></dd>
          <dt>Mizo meaning</dt><dd><%= v["meaning_mizo"] %></dd>
          <dt>Example</dt><dd>“<%= v["example_mizo"] %>”</dd>
          <dt>Category · Level</dt><dd><%= Editorial::BodyForm::CATEGORIES[v["category"]] || "—" %> · <%= v["difficulty"] || "—" %></dd>
          <dt>Games</dt><dd><%= Array(v["game_modes"]).map { |mode| Editorial::BodyForm::GAME_MODES[mode] || mode }.join(", ").presence || "All games" %></dd>
        </dl>
      </div>
    <% when "question" %>
      <dl class="preview-list">
        <dt>Question</dt><dd><%= v["emoji"] %> <strong><%= v["prompt_mizo"] %></strong></dd>
        <dt>Options</dt><dd><ol type="A"><% v["options"].each do |option| %><li><%= option %><%= " ✓" if option == v["answer"] %></li><% end %></ol></dd>
        <dt>Explanation</dt><dd><%= v["explanation_mizo"] %></dd>
        <dt>Level</dt><dd><%= v["difficulty"] %></dd>
      </dl>
    <% when "game_copy" %>
      <dl class="preview-list">
        <dt>Game</dt><dd><strong><%= Editorial::BodyForm::GAMES[v["game_id"]] || v["game_id"] %></strong></dd>
        <% %w[title subtitle prompt hint correct_feedback retry_feedback].each do |key| %>
          <% if v[key].present? %><dt><%= key.humanize %></dt><dd><%= v[key] %></dd><% end %>
        <% end %>
        <% if v["instructions"].present? %><dt>How to play</dt><dd><ol><% v["instructions"].lines.each do |line| %><li><%= line %></li><% end %></ol></dd><% end %>
      </dl>
    <% when "sentence" %>
      <dl class="preview-list">
        <dt>Sentence</dt><dd><strong><%= v["text_mizo"] %></strong></dd>
        <dt>English</dt><dd><%= v["english_support"] %></dd>
        <dt>Level</dt><dd><%= v["difficulty"] || "—" %></dd>
      </dl>
    <% end %>
  </div>
<% end %>
