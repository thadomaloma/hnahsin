<div class="section-head"><div><span class="eyebrow" style="color:var(--green)"><%= @content_item.title %> · r<%= @revision.number %></span><h1>Independent review</h1></div></div><div class="card" style="margin-bottom:18px"><%= render "editorial/content_revisions/preview", content_item: @content_item, revision: @revision %></div><div class="split"><div class="form-card"><%= form_with model: [:editorial, @content_item, @revision, @review_decision] do |form| %><%= form.label :review_kind %><%= form.select :review_kind, @content_item.required_review_kinds.select { |kind| current_user.can_review?(kind) }.map { |kind| [kind.humanize, kind] } %><%= form.label :decision %><%= form.select :decision, [["Approve", "approved"], ["Reject", "rejected"]] %><%= form.label :notes %><%= form.text_area :notes, style: "min-height:140px", placeholder: "Record evidence, corrections or context…" %><p class="hint">Notes are mandatory when rejecting content.</p><%= form.submit "Record decision" %><% end %></div><pre class="json"><%= JSON.pretty_generate(@revision.body) %></pre></div>
