<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Thumal Quest Editorial Studio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <link rel="icon" type="image/svg+xml" href="<%= brand_favicon_data_uri %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="/editorial.css">
    <script src="/editorial_upload.js" defer></script>
    <script src="/editorial_nav.js" defer></script>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="<%= current_user ? dashboard_path : new_session_path %>">
        <span class="brand-mark">TQ</span>
        <span><strong>Thumal Quest</strong><small>Editorial Studio</small></span>
      </a>
      <% if current_user %>
        <nav aria-label="Primary navigation">
          <%= link_to "Overview", dashboard_path, class: ("current" if current_page?(dashboard_path)) %>
          <%= link_to "Content", editorial_content_items_path, class: ("current" if request.path.start_with?("/editorial/content_items")) %>
          <% if %w[language culture].any? { |kind| current_user.can_review?(kind) } %><%= link_to "Review", editorial_flag_reviews_path, class: ("current" if request.path.start_with?("/editorial/flag_reviews")) %><% end %>
          <%= link_to "Coverage", editorial_coverage_path, class: ("current" if request.path.start_with?("/editorial/coverage")) %>
          <%= link_to "Releases", editorial_content_packs_path, class: ("current" if request.path.start_with?("/editorial/content_packs")) %>
          <%= link_to flutter_web_test_url, id: "game-test-link", target: "_blank", rel: "noopener", class: "external", title: "Opens the local Flutter web build (flutter run -d web-server --web-port=5050) in its own window" do %>Game test <span aria-hidden="true">&#8599;</span><% end %>
        </nav>
        <div class="identity" title="Signed in as <%= current_user.email %> (<%= current_user.role.humanize %>)">
          <span class="avatar <%= role_pill_class(current_user.role) %>" aria-hidden="true"><%= initials_for(current_user.email) %></span>
          <%= button_to session_path, method: :delete, class: "button ghost compact" do %><%= action_icon(:logout) %>Sign out<% end %>
        </div>
      <% end %>
    </header>

    <main class="shell">
      <% if notice %><div class="flash success" role="status"><%= notice %></div><% end %>
      <% if alert %><div class="flash danger" role="alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
