{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thumalquest.app/schemas/content-item-2.0.json",
  "title": "Thumal Quest Content Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "type",
    "language",
    "status",
    "content",
    "learning",
    "variants",
    "provenance",
    "rights",
    "reviews",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
    "revision": {"type": "integer", "minimum": 1},
    "type": {
      "enum": ["word", "sentence", "question", "spelling", "story", "culture"]
    },
    "language": {"type": "string", "minLength": 2},
    "status": {
      "enum": ["draft", "language_review", "learning_review", "cultural_review", "approved", "published", "rejected", "retired"]
    },
    "content": {"type": "object", "minProperties": 1},
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tq_level", "age_floor", "skills", "categories", "difficulty", "sensitive", "cultural_review_required", "game_modes"],
      "properties": {
        "tq_level": {"enum": ["TQ0", "TQ1", "TQ2", "TQ3", "TQ4", "TQ5", "TQ6", "TQ7"]},
        "age_floor": {"type": "integer", "minimum": 3},
        "age_ceiling": {"type": ["integer", "null"], "minimum": 3},
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["vocabulary", "spelling", "reading", "sentence", "culture"]}
        },
        "categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 7},
        "sensitive": {"type": "boolean"},
        "cultural_review_required": {"type": "boolean"},
        "game_modes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["form", "kind", "register", "reviewed"],
        "properties": {
          "form": {"type": "string", "minLength": 1},
          "kind": {"enum": ["accepted", "display", "search_alias", "common_error"]},
          "register": {"type": ["string", "null"]},
          "region": {"type": ["string", "null"]},
          "note_mizo": {"type": ["string", "null"]},
          "reviewed": {"type": "boolean"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_title", "contributor_id", "machine_assisted"],
      "properties": {
        "source_type": {"enum": ["council", "dictionary", "curriculum", "author", "oral", "machine_draft"]},
        "source_title": {"type": "string", "minLength": 1},
        "source_locator": {"type": ["string", "null"]},
        "contributor_id": {"type": "string", "minLength": 1},
        "machine_assisted": {"type": "boolean"},
        "machine_service": {"type": ["string", "null"]},
        "machine_checked_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "copyright_holder", "commercial_use_allowed", "derivatives_allowed"],
      "properties": {
        "license": {"type": "string", "minLength": 1},
        "copyright_holder": {"type": "string", "minLength": 1},
        "consent_record_id": {"type": ["string", "null"]},
        "commercial_use_allowed": {"type": "boolean"},
        "derivatives_allowed": {"type": "boolean"},
        "attribution": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "decision", "reviewer_id", "reviewed_revision", "reviewed_at", "note"],
        "properties": {
          "stage": {"enum": ["language", "learning", "cultural", "safety"]},
          "decision": {"enum": ["approved", "changes_requested", "rejected"]},
          "reviewer_id": {"type": "string", "minLength": 1},
          "reviewed_revision": {"type": "integer", "minimum": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "note": {"type": "string"}
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pack_id": {"type": "string"},
        "pack_version": {"type": "string"},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "retired_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
